#!/bin/bash
# decisions-check v1
#
# Checks the decision files of a Flow decision log against the format in
# skills/docs/decisions.md. Bash and awk only (macOS bash 3.2 and BSD awk).
#
# Usage: decisions-check [--project] [--areas a,b,c] <dir>
#   --project      project layout: needs project + slice, no work, touches ignored, area optional
#   --areas a,b,c  the allowed values of area (from `areas:` in .flow.yml)
# Checks every *.md with a `kind:` key in <dir> (README.md is skipped); files
# without `kind:` are legacy: skipped and counted.
# Output: `file: problem` per error, `file: warning: ...` per warning, then
# `checked N, legacy M, errors K, warnings W`. Exit 1 when K > 0, 2 on bad usage.

project=0
areas=""
dir=""
while [ $# -gt 0 ]; do
  case "$1" in
    --project) project=1; shift ;;
    --areas)
      if [ $# -lt 2 ]; then echo "decisions-check: --areas needs a value" >&2; exit 2; fi
      areas="$2"; shift 2 ;;
    -h|--help) sed -n '4,14p' "$0"; exit 0 ;;
    -*) echo "decisions-check: unknown option $1" >&2; exit 2 ;;
    *)
      if [ -n "$dir" ]; then echo "decisions-check: one directory only" >&2; exit 2; fi
      dir="$1"; shift ;;
  esac
done
if [ -z "$dir" ] || [ ! -d "$dir" ]; then
  echo "usage: decisions-check [--project] [--areas a,b,c] <dir>" >&2
  exit 2
fi

read -r -d '' PROG <<'AWK' || true
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
function err(m) { print "E " m }
function warn(m) { print "W " m }
function inlist(v, csv,   a, n, i) {
  n = split(csv, a, ",")
  for (i = 1; i <= n; i++) if (trim(a[i]) == v) return 1
  return 0
}
BEGIN { infm = 1; nh = 0; cur = 0; fence = 0; seentitle = 0; bl = 0; dl = 0; blk = 0; closed = 0; legacy = 0 }
NR == 1 {
  if ($0 !~ /^---[ \t\r]*$/) { legacy = 1; exit }
  next
}
infm {
  if ($0 ~ /^---[ \t\r]*$/) {
    infm = 0; closed = 1
    if (!("kind" in V)) { legacy = 1; exit }
    next
  }
  if ($0 ~ /^[ \t]*-([ \t]|$)/) { blk = 1; next }
  if (trim($0) == "") next
  if ($0 ~ /^[A-Za-z_][A-Za-z_]*:/) {
    p = index($0, ":")
    key = substr($0, 1, p - 1)
    if (key in V) err("duplicate key " key)
    V[key] = trim(substr($0, p + 1))
    next
  }
  if ($0 ~ /^[ \t]/) next
  err("unreadable frontmatter line: " $0)
  next
}
{
  bl++
  if ($0 ~ /^[ \t]*```/) { fence = !fence; next }
  if (fence) next
  if (!seentitle && trim($0) != "") {
    seentitle = 1
    if ($0 !~ /^# [^#]/) err("first line after the frontmatter must be '# <Title>'")
    next
  }
  if (nh == 0 && $0 ~ /^\*\*Date\*\*:/) { datev = trim(substr($0, 10)); next }
  if ($0 ~ /^## /) { H[++nh] = trim(substr($0, 4)); cur = nh; next }
  if (cur > 0 && H[cur] == "The decision" && trim($0) != "") dl++
}
END {
  if (legacy) { print "LEGACY"; exit }
  if (!closed) { err("frontmatter is not closed by a --- line"); exit }

  # keys allowed
  split("kind status superseded_by resolved_by work project slice area touches description", AK, " ")
  for (i = 1; i <= 10; i++) allowed[AK[i]] = 1
  for (k in V) if (!(k in allowed)) err("unknown key " k)
  if (blk) err("block list in the frontmatter: use the flow form [a, b]")

  kind = V["kind"]
  if (kind == "decision") { s1 = "active"; s2 = "superseded"; lk = "superseded_by"; ok = "resolved_by"; hexp = "The decision|Context|Alternatives discarded|Consequences|Reopen when|References|Status log" }
  else if (kind == "deferral") { s1 = "open"; s2 = "resolved"; lk = "resolved_by"; ok = "superseded_by"; hexp = "The decision|Context|Why deferred|Consequences|Reopen when|References|Status log" }
  else err("kind must be decision or deferral, found '" kind "'")

  if (kind == "decision" || kind == "deferral") {
    if (!("status" in V)) err("missing status")
    else if (V["status"] != s1 && V["status"] != s2) err("status of a " kind " must be " s1 " or " s2 ", found '" V["status"] "'")
    if (ok in V) err(ok " is not valid for kind " kind)
    if (!(lk in V)) err("missing " lk)
    else if ("status" in V) {
      if (V["status"] == s1 && V[lk] != "null") err(lk " must be null while status is " s1)
      if (V["status"] == s2 && (V[lk] == "null" || V[lk] == "")) err(lk " is required when status is " s2)
    }
  }

  if (project) {
    if ("work" in V) err("work is not valid in the project layout: use project and slice")
    if (!("project" in V) || V["project"] == "") err("missing project")
    if (!("slice" in V) || V["slice"] == "") err("missing slice (null when outside a slice)")
  } else {
    if ("project" in V) err("project is not valid in the repo layout: use work")
    if ("slice" in V) err("slice is not valid in the repo layout: use work")
    if (!("work" in V) || V["work"] == "") err("missing work (null for a decision outside a work)")
  }

  if ("area" in V) {
    a = V["area"]
    if (a !~ /^[a-z0-9]+(-[a-z0-9]+)*$/) err("area must be one kebab-case word, found '" a "'")
    else if (areas != "" && !inlist(a, areas)) err("area '" a "' is not in the declared areas (" areas ")")
  } else if (!project) err("missing area")

  if (!project) {
    if (!("touches" in V)) err("missing touches")
    else if (V["touches"] == "") { if (!blk) err("touches is empty") }
    else if (V["touches"] !~ /^\[.*\]$/) err("touches must be a flow list [a, b]")
    else {
      t = trim(substr(V["touches"], 2, length(V["touches"]) - 2))
      if (t == "") err("touches is empty")
      else {
        n = split(t, TI, ",")
        for (i = 1; i <= n; i++) if (trim(TI[i]) == "") { err("touches has an empty item"); break }
      }
    }
  }

  if (!("description" in V)) err("missing description")
  else {
    d = V["description"]
    if (length(d) < 2 || d !~ /^".*"$/) err("description must be a quoted string")
    else {
      d = substr(d, 2, length(d) - 2)
      gsub(/[\200-\277]/, "", d)
      if (length(d) == 0) err("description is empty")
      else if (length(d) > 160) err("description is " length(d) " characters (max 160)")
    }
  }

  # title and date
  if (!seentitle) err("no title")
  if (datev == "") err("missing '**Date**: YYYY-MM-DD' line under the title")
  else if (datev !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) err("date must be YYYY-MM-DD, found '" datev "'")
  else if (substr(fname, 1, 10) != datev) err("date " datev " differs from the file name's date")
  if (fname !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-.+\.md$/) err("file name must be YYYY-MM-DD-<slug>.md")

  # headings
  if (hexp != "") {
    ne = split(hexp, E, "|")
    last = 0; bad = 0
    for (i = 1; i <= nh; i++) {
      idx = 0
      for (j = 1; j <= ne; j++) if (E[j] == H[i]) idx = j
      if (idx == 0) { err("unexpected heading '## " H[i] "'"); continue }
      if (seen[idx]) { err("duplicate heading '## " H[i] "'"); continue }
      seen[idx] = 1
      if (idx < last) bad = 1
      last = idx
    }
    for (j = 1; j <= ne; j++) if (!seen[j]) err("missing heading '## " E[j] "'")
    if (bad) err("headings out of order; expected, in order: " hexp)
    if (seen[1] && dl != 1) err("'## The decision' must hold exactly one non-empty line, found " dl)
  }

  if (bl > 40) warn("body is " bl " lines (roughly 40 at most): move the analysis to a linked document")
}
AWK

checked=0; legacy=0; errors=0; warnings=0
for f in "$dir"/*.md; do
  [ -f "$f" ] || continue
  base=$(basename "$f")
  [ "$base" = "README.md" ] && continue
  out=$(LC_ALL=C awk -v project="$project" -v areas="$areas" -v fname="$base" "$PROG" "$f")
  if [ "$out" = "LEGACY" ]; then legacy=$((legacy + 1)); continue; fi
  checked=$((checked + 1))
  while IFS= read -r line; do
    case "$line" in
      "E "*) echo "$base: ${line#E }"; errors=$((errors + 1)) ;;
      "W "*) echo "$base: warning: ${line#W }"; warnings=$((warnings + 1)) ;;
    esac
  done <<EOF
$out
EOF
done
echo "checked $checked, legacy $legacy, errors $errors, warnings $warnings"
[ "$errors" -eq 0 ]
